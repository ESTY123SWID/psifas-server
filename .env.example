# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local dev with `npm run db:local`: postgresql://psifas:psifas@localhost:5433/psifas
DATABASE_URL=

# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_DAYS=7

# Comma-separated browser origins allowed to call the API with cookies (the React app).
CLIENT_ORIGINS=http://localhost:5173

# Cookie settings. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the client and API are on different sites.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the app (1 on Render / most PaaS hosts).
TRUST_PROXY=0

# Public URL of this API (including /api). Used to build image URLs.
API_PUBLIC_URL=http://localhost:4000/api

# Image storage:
#   local      = DEVELOPMENT ONLY (server disk, served by /api/media).
#   cloudinary = permanent storage for production (free plan, no card) — needs CLOUDINARY_URL.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (Cloudinary dashboard → API Keys → "API environment variable")
CLOUDINARY_URL=
# Optional separate secret for signed image URLs (>= 32 chars). Derived from JWT_SECRET if empty.
MEDIA_URL_SECRET=

# Max login/register attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# Test database used by `npm test` (it is wiped on every run!).
# Local: postgresql://psifas:psifas@localhost:5433/psifas_test
TEST_DATABASE_URL=

# Used only by `npm run seed:admin` to create / promote the first system admin.
# Prefer passing these on the command line for one run. Never keep ADMIN_PASSWORD in a file:
# for a new account, leave it empty and type the password at the hidden prompt.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
